# Copy to `.env` and edit:  cp .env.example .env
# This is the ONLY place game version / resources are configured.

# Exact Minecraft version HeadlessMC launches (default 1.21.11).
MC_VERSION=1.21.11
# Mod loader: fabric (only tested loader for this image).
MC_LOADER=fabric
# Game JVM heap — keep well under the container memory limit.
MC_XMX=1280M
# Seconds to wait for Microsoft device login before launching anyway.
HMC_LOGIN_TIMEOUT=600
# 1 = skip Microsoft login (dashboard-only testing, game will not launch).
HMC_SKIP_LOGIN=0
# 1 = enforce lean software-rendering settings every boot (recommended).
HMC_LEAN_GFX=1
# 1 = disable Xvfb, use the -lwjgl stub (breaks textures — not recommended).
HMC_NO_XVFB=0

# Optional: seed the dashboard password on FIRST boot only (min 4 chars here,
# but prefer the browser setup form with 12+ chars). Unset after first boot —
# an existing password hash always wins and this never overwrites it.
# DASHBOARD_PASSWORD=
